# Discord Bot
DISCORD_TOKEN=your-bot-token-here

# MariaDB (Proxmox上)
DB_HOST=192.168.x.x
DB_PORT=3306
DB_USER=discord_bot
DB_PASSWORD=xxxxx
DB_NAME=discord_to_ai

# 監視対象チャンネルが未設定(watched_channelsテーブルが空)の場合のフォールバック
# カンマ区切りでチャンネルIDを指定
WATCHED_CHANNEL_IDS=

# 監視対象チャンネル一覧をDBから再読込する間隔(ミリ秒)
WATCHED_CHANNELS_REFRESH_MS=60000

# Redis (カーソル管理・差分候補キュー用)
REDIS_HOST=192.168.x.x
REDIS_PORT=6379
REDIS_PASSWORD=

# Web管理画面
# 初回起動時に作られる管理者アカウント。以降は画面からユーザーを追加する
# (すでにアカウントが1件でもある場合、この設定は無視される)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=管理者
# Pterodactylが割り当てたポート(SERVER_PORTが自動で入るので通常は空でよい)
WEB_PORT=
# セッションcookieの署名鍵。未設定だと再起動でログアウトされる
# openssl rand -hex 32 などで生成した値を入れる
WEB_SESSION_SECRET=
# リバースプロキシ(nginx等)配下で動かす場合は true
WEB_BEHIND_PROXY=false
# HTTPS経由でのみアクセスさせる場合は true(外部公開時は強く推奨)
WEB_SECURE_COOKIE=false
# Web画面の公開URL。Discordログインのコールバック先に使う
# 例: https://tasks.example.com  (末尾のスラッシュ不要)
WEB_BASE_URL=

# Discordログイン(OAuth2)
# Developer Portal → OAuth2 で Client ID / Client Secret を取得し、
# Redirects に  <WEB_BASE_URL>/auth/discord/callback  を登録すること
# 未設定ならメール+パスワードのログインのみになる
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 判定エンジンの選択
#   rules  = ルールベース判定。APIコスト完全ゼロ(デフォルト)
#   claude = Claude API。従量課金が発生する
AI_PROVIDER=rules

# Claude API (AI_PROVIDER=claude のときだけ必要)
# 無料運用中は設定不要。課金を始めるときにキーを入れて AI_PROVIDER=claude にする
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
